<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JobFinderLite.Application.ViewModels;assembly=JobFinderLite.Application"
             x:Class="JobFinderLite.Mobile.Controls.JobCardView"
             x:DataType="vm:JobCardViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <!-- Card Border Style -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Stroke" Value="#E5E7EB" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="12" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#000000"
                                Offset="0,2"
                                Radius="4"
                                Opacity="0.06" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Typography Styles -->
            <Style x:Key="JobTitleStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#1F2937" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="MaxLines" Value="2" />
            </Style>

            <Style x:Key="CompanyLocationStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="None" />
                <Setter Property="TextColor" Value="#6B7280" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="MaxLines" Value="1" />
            </Style>

            <Style x:Key="PayRateStyle" TargetType="Label">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#1D4ED8" />
            </Style>

            <Style x:Key="PostedTimeStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="#9CA3AF" />
                <Setter Property="HorizontalTextAlignment" Value="End" />
            </Style>

            <!-- Chip & Badge Styles -->
            <Style x:Key="AppliedBadgeBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#E0E7FF" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="6" />
                    </Setter.Value>
                </Setter>
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="6,2" />
            </Style>

            <Style x:Key="AppliedBadgeLabel" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#3730A3" />
                <Setter Property="Text" Value="Applied ✓" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Border Style="{StaticResource CardBorderStyle}"
            AutomationId="JobCard_CardBorder">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding SelectJobCommand}"
                                  AutomationId="JobCard_TapRecognizer" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="8"
              AutomationId="JobCard_Grid">

            <!-- Row 0: Title, Applied Badge, and Save Icon -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">
                <!-- Title -->
                <Label Grid.Column="0"
                       Text="{Binding Title}"
                       Style="{StaticResource JobTitleStyle}"
                       VerticalOptions="Center"
                       AutomationId="JobCard_Title" />

                <!-- Applied Badge -->
                <Border Grid.Column="1"
                        IsVisible="{Binding IsApplied}"
                        Style="{StaticResource AppliedBadgeBorder}"
                        VerticalOptions="Center"
                        AutomationId="JobCard_AppliedBadge">
                    <Label Style="{StaticResource AppliedBadgeLabel}" />
                </Border>

                <!-- Save / Bookmark Button: 44x44 minimum tap target -->
                <Button Grid.Column="2"
                        WidthRequest="44"
                        HeightRequest="44"
                        MinimumWidthRequest="44"
                        MinimumHeightRequest="44"
                        Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        FontSize="20"
                        Command="{Binding ToggleSaveCommand}"
                        AutomationId="JobCard_SaveButton">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsSaved}" Value="True">
                            <Setter Property="Text" Value="★" />
                            <Setter Property="TextColor" Value="#EAB308" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsSaved}" Value="False">
                            <Setter Property="Text" Value="☆" />
                            <Setter Property="TextColor" Value="#9CA3AF" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- Row 1: Company · Location -->
            <Label Grid.Row="1"
                   Text="{Binding CompanyLocation}"
                   Style="{StaticResource CompanyLocationStyle}"
                   AutomationId="JobCard_CompanyLocation" />

            <!-- Row 2: Pay Rate & Relative Posted Date -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <!-- Pay Rate -->
                <Label Grid.Column="0"
                       Text="{Binding PayRate}"
                       Style="{StaticResource PayRateStyle}"
                       VerticalOptions="Center"
                       AutomationId="JobCard_PayRate" />

                <!-- Relative Posted Time -->
                <Label Grid.Column="1"
                       Text="{Binding RelativePostedTime}"
                       Style="{StaticResource PostedTimeStyle}"
                       VerticalOptions="Center"
                       AutomationId="JobCard_PostedTime" />
            </Grid>

            <!-- Row 3: Job Type Chip (Pill shape 12 radius, tinted background) -->
            <HorizontalStackLayout Grid.Row="3"
                                   Spacing="6"
                                   AutomationId="JobCard_ChipsContainer">
                <Border BackgroundColor="{Binding JobTypeBgHex}"
                        StrokeThickness="0"
                        Padding="10,4"
                        AutomationId="JobCard_JobTypeChip">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="{Binding JobType}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{Binding JobTypeColorHex}" />
                </Border>
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
